  <property name="styleSheet">
   <string notr="true">/* =========================================================
   ১. ব্যাকগ্রাউন্ড এবং সেন্ট্রাল উইজেট
   ========================================================= */
QMainWindow, QWidget#centralwidget {
    background-color: #0f172a;
}

/* =========================================================
   ২. বামপাশের সাইডবার (leftPanel)
   ========================================================= */
QFrame#leftPanel {
    background-color: #1e293b;
    border-right: 1px solid #334155;
}

/* সাইডবারের সবগুলো বাটন (dash...ton, bat...ton, opt...ton, sett...tton) */
QFrame#leftPanel QPushButton {
    background-color: transparent;
    color: #94a3b8;
    border: none;
    padding: 12px 16px;
    text-align: left;
    font-size: 13px;
    font-weight: bold;
    border-radius: 8px;
}

QFrame#leftPanel QPushButton:hover {
    background-color: #334155;
    color: #38bdf8;
}

/* =========================================================
   ৩. মেইন টাইটেল (mainTitle)
   ========================================================= */
QLabel#mainTitle {
    color: #f8fafc;
    font-size: 20px;
    font-weight: bold;
    padding-bottom: 5px;
}

/* =========================================================
   ৪. কার্ড বা গ্রুপ বক্স (cardCPU, card...tery, Car...ons)
   ========================================================= */
QGroupBox {
    background-color: #1e293b;
    color: #38bdf8;
    border: 1px solid #334155;
    border-radius: 12px;
    font-weight: bold;
    font-size: 11px;
    margin-top: 20px;
    padding-top: 15px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    left: 12px;
}

/* =========================================================
   ৫. কার্ডের ভেতরের সাধারণ লেবেলগুলো
   ========================================================= */
QGroupBox QLabel {
    color: #cbd5e1;
    font-size: 12px;
    font-weight: 500;
}

/* =========================================================
   ৬. প্রোগ্রেস বারসমূহ (progCPU, pr...AM, pro...r_3)
   ========================================================= */
QProgressBar {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #06b6d4;
    border-radius: 5px;
}

/* =========================================================
   ৭. Quick Actions কার্ডের বাটন (cle...ton, gen...ort)
   ========================================================= */
QGroupBox QPushButton {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 10px;
    font-size: 12px;
    font-weight: bold;
}

QGroupBox QPushButton:hover {
    background-color: #0369a1;
}</string>
